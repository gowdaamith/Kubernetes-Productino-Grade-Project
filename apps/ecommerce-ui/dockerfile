# Stage 1: Build the React Frontned

FROM node:22-bookworm-slim AS frontend-builder
WORKDIR /app/client
COPY client/package.json client/package-lock.json ./

RUN npm ci --legacy-peer-deps
COPY client/ ./
# Generate the optimized production frontend or build the application
RUN npm run build 

#Stage 2: Install the gateway production dependency

FROM node:22-bookworm-slim AS gateway-dependencies
WORKDIR /app/server
COPY server/package.json server/package-lock.json ./
RUN npm ci --omit=dev

#Stage 3: Run the ecommerce UI gateway

FROM node:22-bookworm-slim AS runtime
ENV NODE_ENV=production
ENV PORT=4000

WORKDIR /app

RUN groupadd --system --gid 10001 appgroup \
    && useradd --system --uid 10001 \
       --gid appgroup \
       --home-dir /app \
       --no-create-home \
       appuser
#copy the gateway applicatino code
COPY --from=gateway-dependencies --chown=appuser:appgroup \
    /app/server/node_modules ./server/node_modules
COPY --chown=appuser:appgroup server/package.json ./server/package.json
COPY --chown=appuser:appgroup server/server.js ./server/server.js
COPY --chown=appuser:appgroup server/routes ./server/routes


#copy the compiled react frontend
COPY --from=frontend-builder --chown=appuser:appgroup \
    /app/client/build ./client/build


USER 10001:10001

EXPOSE 4000

CMD ["node", "server/server.js"]





