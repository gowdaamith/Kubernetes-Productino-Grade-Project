Build the docker image : of this product inventory  and use the docker postgres container test the the application locally before building the  kubernetes file or infrastructure for the project

>> docker network create inventory-net
>> docker volume create inventory-postgres-data

>>docker build -t product-inventory:v2 .
>>docker run -d \
  --name inventory-postgres \
  --network inventory-net \
  -e POSTGRES_DB=inventory_db \
  -e POSTGRES_USER=inventory_user \
  -e POSTGRES_PASSWORD=LocalInventoryPass123 \
  -v inventory-postgres-data:/var/lib/postgresql/data \
  postgres:15

>> docker run -d \
  --name product-inventory \
  --network inventory-net \
  -p 3002:3002 \
  -e PORT=3002 \
  -e POSTGRES_HOST=inventory-postgres \
  -e POSTGRES_PORT=5432 \
  -e POSTGRES_DB=inventory_db \
  -e POSTGRES_USER=inventory_user \
  -e POSTGRES_PASSWORD=LocalInventoryPass123 \
  product-inventory:v2

>> docker logs product-inventory

