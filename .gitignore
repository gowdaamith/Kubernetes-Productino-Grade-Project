# Java / Maven / Spring Boot
# ==================================================
target/
*.class
*.jar
*.war
*.ear
hs_err_pid*
replay_pid*

# Preserve Maven Wrapper files if used by the project.
!mvnw
!.mvn/wrapper/maven-wrapper.jar
!.mvn/wrapper/maven-wrapper.properties

